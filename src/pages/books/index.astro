---
// books/index.blade.php
import ActionsHeading from '../../components/ActionsHeading.astro';
import BooksList from '../../components/BooksList.astro';
import EntityList from '../../components/EntityList.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import Tri from '../../layouts/Tri.astro';
import { loadSite, popular, recentlyCreated } from '../../lib/bookstack';

const site = await loadSite();
const popularBooks = popular(site.books, 4);
---

<Tri title="Books" shelfContext="clear">
	<BooksList books={site.books} />

	<Fragment slot="left">
		<div id="popular" class="mb-xl">
			<h5>Popular Books</h5>
			{
				popularBooks.length > 0 ? (
					<EntityList entities={popularBooks} style="compact" />
				) : (
					<div class="body text-muted">The most popular books will appear here.</div>
				)
			}
		</div>

		<div id="new" class="mb-xl">
			<h5>New Books</h5>
			{
				popularBooks.length > 0 ? (
					<EntityList entities={recentlyCreated(site.books, 4)} style="compact" />
				) : (
					<div class="body text-muted">The most recently created books will appear here.</div>
				)
			}
		</div>
	</Fragment>

	<Fragment slot="right">
		<ActionsHeading>
			<ViewToggle type="books" />
		</ActionsHeading>
	</Fragment>
</Tri>

---
// errors/404.blade.php (GitHub Pages serves it for unknown URLs).
import EntityList from '../components/EntityList.astro';
import Base from '../layouts/Base.astro';
import { loadSite, popular } from '../lib/bookstack';

const site = await loadSite();
const columns = [
	{ title: 'Popular Pages', entities: popular(site.pages, 10) },
	{ title: 'Popular Books', entities: popular(site.books, 10) },
	{ title: 'Popular Chapters', entities: popular(site.chapters, 10) },
];
---

<Base>
	<div class="container mt-l">
		<div class="card mb-xl px-l pb-l pt-l">
			<div class="grid half v-center">
				<div>
					<h1 class="list-heading">Page Not Found</h1>
					<h5>Sorry, The page you were looking for could not be found.</h5>
					<p>If you expected this page to exist, you might not have permission to view it.</p>
				</div>
				<div class="text-right">
					<a href="/" class="button outline">Return to home</a>
				</div>
			</div>
		</div>

		<div class="grid third gap-xxl">
			{
				columns.map((column) => (
					<div>
						<div class="card mb-xl">
							<h3 class="card-title">{column.title}</h3>
							<div class="px-m">
								<EntityList entities={column.entities} style="compact" />
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</Base>

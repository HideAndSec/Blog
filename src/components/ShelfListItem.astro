---
// shelves/parts/list-item.blade.php
import { coverUrl, excerpt, type Shelf } from '../lib/bookstack';
import Icon from './Icon.astro';
import { sortAttrs } from '../lib/sort';

interface Props {
	shelf: Shelf;
	index?: number;
}
const { shelf, index = 0 } = Astro.props;
---

<a
	href={shelf.url}
	class="shelf entity-list-item"
	data-entity-type="bookshelf"
	data-entity-id={shelf.id}
	{...sortAttrs(shelf, index)}
>
	<div
		class={`entity-list-item-image bg-bookshelf ${shelf.cover ? 'has-image' : ''}`}
		style={`background-image: url('${coverUrl(shelf)}')`}
	>
		<Icon name="bookshelf" />
	</div>
	<div class="content py-xs">
		<h4 class="entity-list-item-name break-text">{shelf.name}</h4>
		<div class="entity-item-snippet">
			<p class="text-muted break-text mb-none">{excerpt(shelf)}</p>
		</div>
	</div>
</a>
<div class="entity-shelf-books grid third gap-y-xs entity-list-item-children">
	{
		shelf.books.map((book) => (
			<div>
				<a href={`${book.url}?shelf=${shelf.id}`} class="entity-chip text-book">
					<Icon name="book" />
					{book.name}
				</a>
			</div>
		))
	}
</div>
